# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM="Piero & Debby <noreply@teilen.cl>"
RSVP_NOTIFICATION_EMAIL=contacto@teilen.cl
# Opcional si quieres un remitente distinto solo para RSVP:
# RSVP_EMAIL_FROM="Piero & Debby <noreply@teilen.cl>"

# Dashboard privado
DASHBOARD_ACCESS_CODE=
# Opcional: secreto para firmar la cookie del dashboard.
DASHBOARD_SESSION_SECRET=

# Flow
# El ambiente activo se cambia en src/config/payment.ts.
# FLOW_ENV es solo un override opcional de emergencia.
# FLOW_ENV=production

# Credenciales por ambiente. Recomendado para alternar sin editar secretos.
FLOW_PRODUCTION_API_KEY=
FLOW_PRODUCTION_SECRET_KEY=
FLOW_SANDBOX_API_KEY=
FLOW_SANDBOX_SECRET_KEY=

# Compatibilidad legacy: se usan si no existen las credenciales especificas del ambiente.
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Overrides opcionales. Normalmente no los definas:
# FLOW_PRODUCTION_API_URL=https://www.flow.cl/api
# FLOW_SANDBOX_API_URL=https://sandbox.flow.cl/api
FLOW_PRODUCTION_API_URL=
FLOW_SANDBOX_API_URL=

BASE_URL=https://www.pieroydebby.cl

# Recuperación de pagos / Vercel Cron
# Usa secretos largos y distintos. El cron solo considera órdenes creadas
# desde esta fecha, para no enviar correos históricos al primer despliegue.
CRON_SECRET=
ABANDONED_CART_RECOVERY_START_AT=
EMAIL_TEST_TOKEN=
