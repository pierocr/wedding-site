NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JKS8N20GNR

# Flow
# El ambiente activo se cambia en src/config/payment.ts.
# FLOW_ENV es solo un override opcional de emergencia.
# FLOW_ENV=production

# Credenciales por ambiente. Recomendado para alternar sin editar secretos.
FLOW_PRODUCTION_API_KEY=
FLOW_PRODUCTION_SECRET_KEY=
FLOW_SANDBOX_API_KEY=
FLOW_SANDBOX_SECRET_KEY=

# Compatibilidad legacy: se usan si no existen las credenciales especificas del ambiente.
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Override opcional. Normalmente no lo definas:
# production => https://www.flow.cl/api
# sandbox => https://sandbox.flow.cl/api
FLOW_API_URL=

BASE_URL=https://www.pieroydebby.cl
